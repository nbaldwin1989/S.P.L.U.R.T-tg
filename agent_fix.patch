An implementation resolving the issue by enabling large painting frames to be crafted via the construction menu and purchased via cargo:

### 1. Construction Graph and Recipe
Add `paintingFrameLarge` node, edges, and the construction recipe to `Resources/Prototypes/Recipes/Construction/Graphs/furniture/painting_frame.yml`:

```diff
--- a/Resources/Prototypes/Recipes/Construction/Graphs/furniture/painting_frame.yml
+++ b/Resources/Prototypes/Recipes/Construction/Graphs/furniture/painting_frame.yml
@@ -9,6 +9,12 @@
           steps:
             - material: WoodPlank
               amount: 1
               doAfter: 1
+        - to: paintingFrameLarge
+          completed:
+            - !type:SnapToGrid {}
+          steps:
+            - material: WoodPlank
+              amount: 2
+              doAfter: 2
 
     - node: paintingFrame
       entity: PaintingFrame
@@ -20,6 +26,17 @@
             - !type:DeleteEntity {}
           steps:
             - tool: Prying
               doAfter: 1
+
+    - node: paintingFrameLarge
+      entity: PaintingFrameLarge
+      edges:
+        - to: start
+          completed:
+            - !type:SpawnPrototype
+              prototype: MaterialWoodPlank1
+              amount: 2
+            - !type:DeleteEntity {}
+          steps:
+            - tool: Prying
+              doAfter: 1
 
 - type: construction
   id: PaintingFrame
@@ -30,3 +47,12 @@
   description: painting-frame-construction-description
   icon:
     sprite: Structures/Decoration/paintings.rsi
     state: frame
+
+- type: construction
+  id: PaintingFrameLarge
+  graph: PaintingFrame
+  startNode: start
+  targetNode: paintingFrameLarge
+  category: construction-category-furniture
+  description: painting-frame-large-construction-description
+  icon:
+    sprite: Structures/Decoration/paintings.rsi
+    state: frame_large
```

