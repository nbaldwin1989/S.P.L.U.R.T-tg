```yaml
# In Resources/Prototypes/_NF/Entities/Structures/Decoration/paintings.yml (or entity definition for PaintingFrameLarge)
# Ensure PaintingFrameLarge has the Construction component referencing the graph and node:
- type: entity
  id: PaintingFrameLarge
  parent: PaintingFrame
  name: large painting frame
  description: A large wooden frame for hanging paintings.
  components:
  - type: Sprite
    sprite: _NF/Structures/Decoration/paintings.rsi
    state: frame_large
  - type: PaintingFrame
    width: 2
    height: 2
  - type: Construction
    graph: PaintingFrame
    node: paintingFrameLarge
```

```yaml
# In Resources/Prototypes/_NF/Recipes/Construction/Graphs/furniture/painting_frame.yml (or wherever the PaintingFrame construction graph is located)
- type: constructionGraph
  id: PaintingFrame
  start: start
  graph:
    - node: start
      edges:
        - to: paintingFrame
          completed:
            - !type:SnapToGrid {}
          steps:
            - material: Wood
              amount: 2
              doAfter: 1
        - to: paintingFrameLarge
          completed:
            - !type:SnapToGrid {}
          steps:
            - material: Wood
              amount: 4
              doAfter: 2

    - node: paintingFrame
      entity: PaintingFrame
      edges:
        - to: start
          completed:
            - !type:SpawnPrototype
              prototype: MaterialWoodPlank1
              amount: 2
            - !type:DeleteEntity {}
          steps:
            - tool: Prying
              doAfter: 1

    - node: paintingFrameLarge
      entity: PaintingFrameLarge
      edges:
        - to: start
          completed:
            - !type:SpawnPrototype
              prototype: MaterialWoodPlank1
              amount: 4
            - !type:DeleteEntity {}
          steps:
            - tool: Prying
              doAfter: 2

- type: construction
  id: PaintingFrameLarge
  name: large painting frame
  category: construction-category-furniture
  crafting: true
  graph: PaintingFrame
  startNode: start
  targetNode: paintingFrameLarge
```

