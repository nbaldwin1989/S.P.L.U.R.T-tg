```yaml
# Construction Graph & Crafting Recipe for Large Painting Frame
- type: constructionGraph
  id: PaintingFrameLarge
  start: start
  graph:
    - node: start
      edges:
        - to: frame
          completed:
            - !type:SpawnPrototype
              prototype: PaintingFrameLarge
              amount: 1
            - !type:DeleteEntity {}
          steps:
            - material: Wood
              amount: 2
              doAfter: 1
    - node: frame
      entity: PaintingFrameLarge

- type: construction
  id: PaintingFrameLarge
  name: large painting frame
  category: construction-category-items
  graph: PaintingFrameLarge
  start: start
  target: frame
  objectType: Item

# Lathe Recipe
- type: latheRecipe
  id: PaintingFrameLarge
  result: PaintingFrameLarge
  category: Items
  materials:
    Wood: 200

# Cargo Crate
- type: entity
  id: CratePaintingFrameLarge
  parent: CrateWooden
  name: large painting frames crate
  description: A crate containing large painting frames.
  components:
  - type: StorageFill
    contents:
      - id: PaintingFrameLarge
        amount: 3

# Cargo Product
- type: cargoProduct
  id: CratePaintingFrameLarge
  product: CratePaintingFrameLarge
  cost: 400
  category: Service
  group: market
```

